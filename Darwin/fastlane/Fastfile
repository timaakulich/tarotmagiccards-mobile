default_platform(:ios)

platform :ios do
  desc "Deploy to TestFlight"
  lane :beta do
    create_keychain(
      name: "fastlane_tmp_keychain",
      password: ENV["MATCH_PASSWORD"],
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    ) if ENV['CI']

    match(
      type: "appstore",
      keychain_name: ENV['CI'] ? "fastlane_tmp_keychain" : nil,
      keychain_password: ENV['CI'] ? ENV["MATCH_PASSWORD"] : nil
    )

    begin
      last_tag = sh("git tag --sort=-v:refname --merged origin/main | grep -E '^[0-9]+\\.[0-9]+\\.[0-9]+$' | head -1").strip
      current_branch = sh("git rev-parse --abbrev-ref HEAD").strip
      UI.message("Last tag on main: #{last_tag}")
      UI.message("Current branch: #{current_branch}")

      if current_branch == "main"
        version = last_tag
        UI.message("On main branch, using tag version as-is: #{version}")
      else
        version_parts = last_tag.split('.')
        if version_parts.length == 3
          major = version_parts[0].to_i
          minor = version_parts[1].to_i
          patch = version_parts[2].to_i + 1
          version = "#{major}.#{minor}.#{patch}"
          UI.message("On #{current_branch} branch, auto-incremented version: #{version}")
        else
          version = last_tag
          UI.message("Unexpected tag format, using as-is: #{version}")
        end
      end

      build_number = sh("git rev-list #{last_tag}..HEAD --count").strip
    rescue
      version = get_version_number
      UI.message("No git tag found, using current project version: #{version}")
      build_number = number_of_commits(all: false)
    end

    UI.message("Final version: #{version}, build number: #{build_number}")

    increment_version_number(version_number: version)
    increment_build_number(build_number: build_number)

    build_app(
      scheme: "TarotMagicCards App",
      export_method: "app-store",
      clean: true,
      configuration: "Release",
      sdk: "iphoneos",
      destination: "generic/platform=iOS",
      xcconfig: "fastlane/AppStore.xcconfig",
      xcargs: [
        "-skipPackagePluginValidation",
        "-skipMacroValidation",
        "DEVELOPMENT_TEAM=U7Y7892PUU",
        "CODE_SIGN_STYLE=Manual",
        "CODE_SIGN_IDENTITY='iPhone Distribution'",
        "PROVISIONING_PROFILE_SPECIFIER=match AppStore cards.tarotmagic.app"
      ].join(" "),
      derived_data_path: "../.build/Darwin/DerivedData",
      output_directory: "../.build/fastlane/Darwin"
    )

    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )

    delete_keychain(name: "fastlane_tmp_keychain") if ENV['CI']
  end
end
